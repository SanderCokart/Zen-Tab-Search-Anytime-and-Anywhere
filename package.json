{
  "name": "zen-tab-search",
  "version": "4.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "node scripts/zip.mjs",
    "lint": "npm run lint:web-ext",
    "lint:web-ext": "node scripts/lint-web-ext.mjs",
    "lint:js": "eslint app entrypoints features mcp scripts screenshots shared tests",
    "mcp:build": "node scripts/build-mcp.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint:js && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-icons": "node scripts/generate-icons.mjs",
    "release": "node scripts/release.mjs",
    "screenshots": "playwright install chromium && playwright test -c screenshots/playwright.config.ts",
    "screenshots:dev": "npx vite --config screenshots/vite.config.ts",
    "prepare": "husky",
    "postinstall": "node scripts/generate-icons.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix",
    "*.{json,md,css}": "prettier --write",
    "{entrypoints/**/*,public/**/*,wxt.config.ts,package.json}": "npm run lint:web-ext"
  },
  "webExt": {
    "ignoreFiles": [
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "scripts/**",
      "web-ext-artifacts/**",
      ".output/**",
      ".wxt/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "tests/**",
      "screenshots/**",
      "docs/**",
      "icon.png",
      ".gitignore",
      "README.md",
      "eslint.config.js",
      "prettier.config.js",
      "vitest.config.ts",
      "tsconfig.json",
      "wxt.config.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.323",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.27.7",
    "eslint": "^9.28.0",
    "happy-dom": "^17.4.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1",
    "web-ext": "^10.3.0",
    "ws": "^8.22.0",
    "wxt": "^0.20.7",
    "zod": "~4.4.3"
  },
  "dependencies": {
    "@simonwep/pickr": "^1.10.2",
    "@timelang/parse": "^0.1.1",
    "cn": "^0.3.0",
    "preact": "^10.29.8",
    "valibot": "^1.5.0"
  }
}
